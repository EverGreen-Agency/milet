{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/v1/intakes", "destination": "/api/v1/intakes" },
    { "source": "/v1/extract-invoice", "destination": "/api/v1/extract-invoice" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/build-in-public", "destination": "/build-in-public.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/brandbook", "destination": "/brandbook.html" }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/brandbook-web",
      "destination": "/brandbook",
      "permanent": true
    },
    {
      "source": "/brandbook-web/:path*",
      "destination": "/brandbook",
      "permanent": true
    }
  ]
}
