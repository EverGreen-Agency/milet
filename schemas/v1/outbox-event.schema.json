{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milet.app/schemas/v1/outbox-event.schema.json",
  "title": "OutboxEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "organizationId", "aggregateType", "aggregateId", "eventType", "payload", "correlationId", "occurredAt", "availableAt", "attempts"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "string", "pattern": "^ORG-[A-Z0-9][A-Z0-9-]{2,31}$" },
    "aggregateType": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "correlationId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "availableAt": { "type": "string", "format": "date-time" },
    "attempts": { "type": "integer", "minimum": 0 }
  }
}
