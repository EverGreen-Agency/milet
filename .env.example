NODE_ENV=development
PORT=4310
BIND_ADDRESS=127.0.0.1
DATABASE_MODE=fake
DATABASE_URL=postgresql://milet_app:milet_app_local_only@127.0.0.1:55433/milet
DEMO_DATA_ONLY=true
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Worker: um tenant sintético explícito por processo; nunca use credencial owner.
WORKER_TENANT_ID=ORG-0007
WORKER_USER_ID=USR-DEMO-0001
WORKER_ID=milet-worker-01
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_EVENTS_PER_CYCLE=10
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF_SECONDS=10
WORKER_MAX_BACKOFF_SECONDS=300
