NODE_ENV=development
PORT=4310
BIND_ADDRESS=127.0.0.1
DATABASE_MODE=fake
DATABASE_URL=postgresql://milet_app:milet_app_local_only@127.0.0.1:55433/milet
DEMO_DATA_ONLY=true
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Intake real V2: habilite somente com opt-in, DPA/política de privacidade e chaves no ambiente.
# Nunca versione valores reais neste arquivo.
INTAKE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
RESEND_API_KEY=
RESEND_FROM=
INTAKE_NOTIFICATION_TO=

# Worker: um tenant sintético explícito por processo; nunca use credencial owner.
WORKER_TENANT_ID=ORG-0007
WORKER_USER_ID=USR-DEMO-0001
WORKER_ID=milet-worker-01
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_EVENTS_PER_CYCLE=10
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF_SECONDS=10
WORKER_MAX_BACKOFF_SECONDS=300
